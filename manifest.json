{
  "manifest_version": 3,
  "name": "이미지 한글 번역기",
  "short_name": "이미지 번역",
  "version": "2.8.0",
  "description": "현재 페이지 이미지의 일본어를 읽고 원래 크기에 맞춰 한국어로 덮어씁니다.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "이미지 한글 번역기",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "translate-visible-images": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "현재 페이지 전체의 이미지를 번역"
    }
  }
}
